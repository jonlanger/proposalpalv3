# Which AI backend to use: groq | gemini | ollama | demo
# If unset: the first provider with a key (Gemini, then Groq), otherwise demo mode (sample content, no AI).
AI_PROVIDER=gemini

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash   # or gemini-3.1-pro-preview (slower, stronger), gemini-3.5-flash-lite (cheapest)

# Groq (free tier): https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Ollama (local, no key): install from https://ollama.com, then `ollama pull llama3.1`
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434/v1
